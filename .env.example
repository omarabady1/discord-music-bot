# Required: your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Required for /search suggestions: public API key used by the YouTube Music
# web player.
YOUTUBE_MUSIC_API_KEY=

# Optional: path to a Netscape-format cookies.txt file exported from a logged-in
# browser. Needed for age-restricted, private, or bot-checked videos.
YTDLP_COOKIES_FILE=

# Optional: override the bundled binaries.
YTDLP_PATH=
FFMPEG_PATH=

# Optional: minutes of inactivity before the bot leaves the voice channel.
IDLE_DISCONNECT_MINUTES=5

